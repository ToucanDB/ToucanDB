# MANIFEST.in - Specifies which files to include in the package distribution

# Include essential documentation
include README.md
include CHANGELOG.md
include CREDITS.md
include LICENSE.md
include CONTRIBUTING.md
include SECURITY.md
include RELEASE_NOTES.md
include *.cff
recursive-include docs *.md

# Include assets (logos, images)
recursive-include assets *.png *.jpeg

# Include configuration files
include pyproject.toml

# Include examples
recursive-include examples *.py
recursive-include benchmarks *.py

# Include typing marker
include toucandb/py.typed

# Include tests
recursive-include tests *.py

# Exclude repository-only automation from source distributions
prune .github
prune scripts
